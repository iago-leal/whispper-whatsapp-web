+// Cache de mídia da página, como o LruMediaStore do WhatsApp Web (evidence/reproduction.md do BUG-20261002-XDL5): a
+// chave é o filehash; o download devolve dele o buffer guardado, mesmo vazio, e o regrava; o buffer devolvido só é
+// gravado depois dos metadados, quando a página já o entregou a quem pediu, e gravar um buffer desanexado guarda 0 bytes,
+// como new Response(buffer) no Cache Storage.
+const cacheDeMidia = new Map<string, ArrayBuffer>();
+const apagadasDoCache: string[] = [];
+function guardarNoCache(chave: string, buffer: ArrayBuffer): void {
+  setImmediate(() => cacheDeMidia.set(chave, buffer.byteLength > 0 ? buffer.slice(0) : new ArrayBuffer(0)));
+}
