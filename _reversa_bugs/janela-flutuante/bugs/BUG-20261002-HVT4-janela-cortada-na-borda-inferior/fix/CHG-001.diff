+++ b/extension/test/posicionador-colisoes.test.ts
@@ -128,3 +128,71 @@
   assert.equal(porId.get('recebido-2')?.y, 264);
   assert.equal(porId.get('recebido-2')?.deslocadaPorColisao, true);
