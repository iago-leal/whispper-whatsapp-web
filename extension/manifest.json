{
  "manifest_version": 3,
  "name": "whispper-whatsapp-web",
  "description": "Transcrição local das mensagens de voz do WhatsApp Web.",
  "version": "0.1.0",
  "minimum_chrome_version": "111",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "storage",
    "tabs"
  ],
  "action": {
    "default_popup": "dist/popup/index.html",
    "default_title": "Whispper"
  },
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "dist/pagina/ponte-audio.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "dist/content/index.js"
      ],
      "css": [
        "dist/content/estilos.css",
        "dist/content/janela-flutuante.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
